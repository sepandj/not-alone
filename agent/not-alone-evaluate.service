[Unit]
Description=not-alone improvement/evaluation agent (reviews responses, fixes data, emails report)
After=network-online.target

[Service]
Type=oneshot
Environment=HOME=/root
Environment=PATH=/root/.local/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
ExecStart=/usr/bin/python3 /root/not-alone/agent/evaluate.py
