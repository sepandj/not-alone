[Unit]
Description=not-alone low-cost Claude moderation agent (one pass)
After=network-online.target

[Service]
Type=oneshot
Environment=HOME=/root
Environment=PATH=/root/.local/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
ExecStart=/usr/bin/python3 /root/not-alone/agent/moderate.py
