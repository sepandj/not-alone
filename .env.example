# Copy to .env and adjust. Never commit the real .env.
DATABASE_URL=postgresql+psycopg://notalone:CHANGE_ME@localhost:5432/notalone

# Keeps visitor hashes (and therefore distinct-people counts) stable across
# restarts. Set to a long random string; keep it secret.
VISITOR_SALT=CHANGE_ME_TO_A_LONG_RANDOM_STRING

# Optional: path to MaxMind GeoLite2-City.mmdb to enable city/country stats.
# GEOIP_DB_PATH=/opt/not-alone/GeoLite2-City.mmdb
